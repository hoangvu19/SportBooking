# AI Module Environment Variables

# ============================================
# Logging
# ============================================
AI_LOG_LEVEL=info # debug, info, warn, error

# ============================================
# External APIs (Optional)
# ============================================

# OpenAI Moderation API
OPENAI_MODERATION_ENABLED=false
OPENAI_API_KEY=your_openai_api_key_here

# Google Perspective API
PERSPECTIVE_API_ENABLED=false
PERSPECTIVE_API_KEY=your_google_perspective_api_key_here

# Azure Content Moderator
AZURE_MODERATOR_ENABLED=false
AZURE_MODERATOR_KEY=your_azure_moderator_key_here
AZURE_MODERATOR_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
EMBEDDINGS_ENABLED=false
EMBEDDINGS_PROVIDER=openai 
